# Copy this file to .env and fill in your values.
# .env is gitignored -- never commit real API keys.

# LLM provider: openai | ollama
# Provider has NO default -- it must be set explicitly.
# LLM_PROVIDER=openai

# Model is selected at runtime via /config/llm/connect + /config/llm/select.
# Optionally set LLM_MODEL to skip interactive selection in scripts.
# LLM_MODEL=

# BYOK -- set only the key for your chosen provider (Ollama needs no key)
# OPENAI_API_KEY=

# Ollama: optionally override the base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Data directory (SQLite, ChromaDB, cache, uploads)
# VERITAS_DATA_DIR=data

# Sentence-Transformers embedding model
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ingestion concurrency (LLM calls per doc)
# EXTRACT_CONCURRENCY=4

# RAG retrieval top-k
# RETRIEVE_TOP_K=8
